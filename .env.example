# ==============================================================================
# StatIQ Environment Variables Template (SIH26101)
# Copy to appropriate .env files for backend, ai-service, and frontend.
# NEVER commit production credentials or secret keys to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/statiq
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
FLYWAY_ENABLED=true

# Spring Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Backend Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Microservice Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
# AI Provider options: mock | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# iGOT Karmayogi Ecosystem Integration
# Current Hackathon prototype uses MOCK provider
IGOT_PROVIDER_TYPE=MOCK
IGOT_API_BASE_URL=https://igotkarmayogi.gov.in/api/v1
IGOT_API_CLIENT_ID=
IGOT_API_CLIENT_SECRET=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_AI_SERVICE_URL=http://localhost:8000
